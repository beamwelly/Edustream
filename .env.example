# ──────────────────────────────────────────────────────────────────────────────
# EduStream — Root .env (used by docker-compose at runtime)
# Copy this file to .env and fill in all values before running docker-compose.
# This file is NOT copied into any Docker image.
# ──────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
# Neon PostgreSQL async connection string
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST/DBNAME

# ── Auth / JWT ────────────────────────────────────────────────────────────────
SECRET_KEY=replace-with-a-long-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── CORS / Frontend URL ───────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
FRONTEND_URL=http://localhost,https://yourdomain.com

# ── Supabase Storage ──────────────────────────────────────────────────────────
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_BUCKET=edustream-content-library

# ── Google OAuth (Calendar + Meet) ───────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/meetings/google/callback

# ── Zoom Webinar ──────────────────────────────────────────────────────────────
ZOOM_ACCOUNT_ID=your-zoom-account-id
ZOOM_CLIENT_ID=your-zoom-client-id
ZOOM_CLIENT_SECRET=your-zoom-client-secret
ZOOM_WEBHOOK_SECRET=your-zoom-webhook-secret

# ── SMTP Email ────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=your-email@gmail.com

# ── Redis Cache ───────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# ── Frontend (Vite build-time) ────────────────────────────────────────────────
# This is used ONLY during the frontend Docker build to set the API base URL.
VITE_API_URL=http://localhost:8000
